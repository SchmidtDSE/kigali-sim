start default

  define application "test"

    uses substance "test"
      enable domestic
      initial charge with 1 kg / unit for domestic
      retire 5 year old mean weibull
      set domestic to 100 units
      cap domestic to 60 units during years 3 to 12
      equals 5 tCO2e / mt
    end substance

  end application

end default


start simulations

  simulate "business as usual" from years 1 to 12

end simulations