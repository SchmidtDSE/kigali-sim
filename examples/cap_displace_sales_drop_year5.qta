start default

  define application "Test"
  
    uses substance "SubA"
      enable domestic
      initial charge with 1 kg / unit for domestic
      initial charge with 0 kg / unit for import
      initial charge with 0 kg / unit for export
      equals 1 kgCO2e / kg
      equals 1 kwh / unit
      set sales to 1000 units during year 1
      retire 5 % / year
      recharge 5 % of priorEquipment with 0.85 kg / unit
    end substance


    uses substance "SubB"
      enable domestic
      initial charge with 1 kg / unit for domestic
      initial charge with 0 kg / unit for import
      initial charge with 0 kg / unit for export
      equals 1 kgCO2e / kg
      equals 1 kwh / unit
      set sales to 0 units during year 1
      retire 5 % / year
      recharge 5 % of priorEquipment with 0.85 kg / unit
    end substance
  
  end application

end default


start policy "Permit"

  modify application "Test"
  
    modify substance "SubA"
      cap domestic to 1000 - (yearsElapsed - 1) * 100 units displacing "SubB" during years 3 to 4
    end substance
  
  end application

end policy


start simulations

  simulate "BAU"
  from years 1 to 10


  simulate "With Permit"
    using "Permit"
  from years 1 to 10

end simulations
