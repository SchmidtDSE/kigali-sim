start default

  define application "test"

    uses substance "test"
      enable domestic
      initial charge with 0.1 kg / unit for domestic
      initial charge with 0 kg / unit for import
      initial charge with 0 kg / unit for export
      equals 1 tCO2e / kg
      equals 0 kwh / unit
      set domestic to 100 units during year 1
      set domestic to 200 units during year 2
      set domestic to 300 units during year 3
      set domestic to 400 units during year 4
      set domestic to 500 units during year 5
      set domestic to 600 units during year 6
      set domestic to 0 kg during year 7
      retire 5 year old exact
    end substance

  end application

end default


start policy "intervention"

  modify application "test"

    modify substance "test"
      recover 100 % with 100 % reuse with 0 % induction at eol during years 7 to onwards
    end substance

  end application

end policy


start simulations

  simulate "business as usual" from years 1 to 17
  simulate "with recycle" using "intervention" from years 1 to 17

end simulations
