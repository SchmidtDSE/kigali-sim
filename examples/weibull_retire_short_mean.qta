start default

  define application "test"

    uses substance "test"
      enable domestic
      initial charge with 1 kg / unit for domestic
      set priorEquipment to 1000 units during year 1
      retire 0.5 year old mean weibull assuming new
      equals 5 tCO2e / mt
    end substance

  end application

end default


start simulations

  simulate "business as usual" from years 1 to 3

end simulations