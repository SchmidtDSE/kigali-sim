start default

  define application "Test"

    uses substance "SubA"
      enable domestic
      initial charge with 1 kg / unit for domestic
      initial charge with 0 kg / unit for import
      initial charge with 0 kg / unit for export
      initial charge with 1 kg / unit for newEquipment
      equals 1 kgCO2e / kg
      equals 1 kwh / unit
      set domestic to 100 units during year 1
      retire 5 % / year
    end substance

  end application

end default


start simulations

  simulate "Result"
  from years 1 to 5

end simulations
