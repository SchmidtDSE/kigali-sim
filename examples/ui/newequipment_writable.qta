start default

  define application "app1"

    uses substance "sub1"
      enable domestic
      initial charge with 1 kg / unit for domestic
      set domestic to 100 units during year 1
      set newEquipment to 50 units during year 1
      change newEquipment by +10 % during years 2 to 3
      cap newEquipment to 200 units during years 4 to 5
      floor newEquipment to 10 units during years 4 to 5
      equals 5 tCO2e / kg
    end substance

  end application

end default


start simulations

  simulate "business as usual" from years 1 to 5

end simulations
