start default

  define application "test"

    uses substance "test"
      enable domestic
      initial charge with 1 kg / unit for domestic
      set domestic to 100 units during year 1
      recharge 10 % of priorEquipment with 1 kg / unit

      # "assume no newEquipment" desugars to "set newEquipment to 0 kg" (mass-path)
      assume no newEquipment during years 2 to 3

      # "assume only recharge newEquipment" desugars to "set newEquipment to 0 units"
      # (unit-path, so recharge/precharge servicing still lands on sales)
      assume only recharge newEquipment during years 4 to 5

      equals 5 tCO2e / kg
    end substance

  end application

end default


start simulations

  simulate "business as usual" from years 1 to 5

end simulations
