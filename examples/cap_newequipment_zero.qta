start default
  define application "Test"
    uses substance "Sub"
      enable domestic
      initial charge with 1 kg / unit for domestic
      initial charge with 0 kg / unit for import
      initial charge with 0 kg / unit for export
      equals 1 kgCO2e / kg
      equals 1 kwh / unit
      set domestic to 1000 units during year 1
      retire 5 % / year
      recharge 5 % of priorEquipment with 0.85 kg / unit
    end substance
  end application
end default

start policy "Cap"
  modify application "Test"
    modify substance "Sub"
      cap newEquipment to 0 units during years 1 to 5
    end substance
  end application
end policy

start simulations
  simulate "Result"
    using "Cap"
  from years 1 to 5
end simulations
